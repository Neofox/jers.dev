---
import ThreeIStudy from "../../components/ThreeIStudy.astro"
import { getImage } from "astro:assets"
import directory from "../../../public/assets/pivo-coaches-current.jpg"

const previews = await Promise.all([480, 800, directory.width].map(width => getImage({ src: directory, width, format: "webp" })))
---

<ThreeIStudy
  slug="pivo-coaches"
  image={previews[2].src}
  imageWidth={directory.width}
  imageHeight={directory.height}
  srcset={previews.map(image => `${image.src} ${image.attributes.width}w`).join(", ")}
  sizes="(min-width: 1174px) 1080px, (max-width: 500px) calc(100vw - 40px), 92vw"
/>
