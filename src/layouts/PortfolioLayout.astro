---
import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import "../styles/globals.css"

interface Props {
  stage?: "work" | "study"
  title: string
  description: string
  socialDescription?: string
  path: string
  image?: string
  imageAlt?: string
  imageWidth?: number
  imageHeight?: number
  type?: "article" | "website"
}
const {
  stage,
  title,
  description,
  socialDescription = description,
  path,
  image = "/assets/jerome-portrait.jpeg",
  imageAlt = "Jérôme Schaeffer",
  imageWidth = 960,
  imageHeight = 960,
  type = "website",
} = Astro.props
const canonical = new URL(path, Astro.site)
const socialImage = new URL(image, Astro.site)
---

<!doctype html>
<html lang="en" data-motion="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
    </style>
    <link rel="expect" href="#page-intro" blocking="render" media="(prefers-reduced-motion: no-preference)" />
    <script is:inline>
      (() => {
        const root = document.documentElement
        const reduced = matchMedia("(prefers-reduced-motion: reduce)")
        function sync() {
          let enabled = !reduced.matches
          try { enabled &&= localStorage.getItem("jerome-studio-motion") !== "off" } catch {}
          root.dataset.motion = enabled ? "on" : "off"
        }
        sync()
        reduced.addEventListener("change", sync)
        window.addEventListener("pageshow", sync)
        window.addEventListener("pagereveal", event => {
          const transition = event.viewTransition
          if (!transition) return
          sync()
          if (root.dataset.motion === "off") return transition.skipTransition()
          const from = window.navigation?.activation?.from
          if (!from?.url) return
          function depth(url) {
            if (url.pathname === "/") return url.hash.startsWith("#about") || url.hash.startsWith("#work") ? 2 : 0
            return url.pathname.replace(/\/$/, "") === "/work" ? 1 : 2
          }
          const direction = depth(location) - depth(new URL(from.url))
          if (direction) transition.types?.add(direction > 0 ? "forward" : "backward")
        })
        window.addEventListener("pageswap", event => {
          if (root.dataset.motion === "off") event.viewTransition?.skipTransition()
        })
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:width" content={imageWidth} />
    <meta name="twitter:image:height" content={imageHeight} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body data-stage={stage}>
    <slot />
    <script is:inline defer src="https://app.rybbit.io/api/script.js" data-site-id="1712"></script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
