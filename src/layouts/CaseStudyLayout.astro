---
import InteriorHeader from "../components/InteriorHeader.astro"
import PortraitDock from "../components/PortraitDock.astro"
import PortfolioLayout from "./PortfolioLayout.astro"
import { localPath, localeFromPath } from "../i18n/locale.js"

interface Props {
  projectName: string
  employer?: "3i" | "Enhans" | "Independent"
  title: string
  description: string
  path: string
  heading: string
  image: string
  imageAlt: string
  imageWidth: number
  imageHeight: number
  srcset?: string
  sizes?: string
}
const { projectName, heading, srcset, sizes, employer = "3i", ...metadata } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
const ko = locale === "ko"
const role = employer === "3i"
  ? (ko ? "프론트엔드 개발자 · AX 엔지니어" : "Frontend Developer & AX Engineer")
  : (ko ? "프론트엔드 개발자" : "Frontend Developer")
const moreLabel = employer === "Independent"
  ? (ko ? "다른 개인 프로젝트 보기" : "More side projects")
  : (ko ? `${employer}에서 진행한 다른 프로젝트 보기` : `More of my work at ${employer}`)
const projectAnchor = metadata.path.split("/").filter(Boolean).pop()
const group = employer === "Independent" ? "side-projects" : employer.toLowerCase()
---

<PortfolioLayout {...metadata} stage="study" type="article">
  <link slot="head" rel="preload" as="image" href={metadata.image} imagesrcset={srcset} imagesizes={sizes} fetchpriority="high" />
  <a class="skip" href="#main">{ko ? "프로젝트 본문으로 건너뛰기" : "Skip to case study"}</a>
  <div class="study">
    <InteriorHeader workHref={`/work/#${projectAnchor}`} />
    <main id="main" tabindex="-1">
      <article>
        <header class="opening" id="page-intro">
          <p class="eyebrow">{ko && employer === "Independent" ? "개인 프로젝트" : employer} · <span data-project-name>{projectName}</span></p>
          <h1>{heading}</h1>
          <p class="lead"><slot name="lead" /></p>
          <p class="byline">Jérôme Schaeffer{employer !== "Independent" && ` · ${role}`}</p>
        </header>
        <figure>
          <img id="study-preview" class="scene" src={metadata.image} {srcset} {sizes} width={metadata.imageWidth}
            height={metadata.imageHeight} fetchpriority="high" alt={metadata.imageAlt} />
          <figcaption><slot name="caption" /></figcaption>
        </figure>
        <slot />
      </article>
    </main>
    <footer><a class="text-link" href={localPath(`/work/#${group}`, locale)}>{moreLabel} <span aria-hidden="true">→</span></a></footer>
  </div>
  <PortraitDock />
</PortfolioLayout>

<style is:global>
  .study {
    width: min(calc(100% - 2 * var(--gutter)), 1080px);
    margin: 0 auto;
    footer {
      padding: 24px 0;
      border-bottom: 1px solid var(--border);
    }
    .opening {
      padding: clamp(40px, 7vw, 88px) 0 32px;
    }
    h1 {
      max-width: 15ch;
      font-size: clamp(42px, 7vw, 92px);
      line-height: 1;
      letter-spacing: -0.045em;
      margin: 16px 0 24px;
    }
    .chapter > h2,
    .demo-section > h2 {
      font-size: clamp(24px, 3vw, 36px);
      line-height: 1.15;
    }
    .lead {
      max-width: 57ch;
      font-size: clamp(18px, 2vw, 24px);
      line-height: 1.5;
    }
    .byline,
    figcaption {
      color: var(--muted);
      font-size: var(--text-sm);
      margin-top: 14px;
    }
    .scene {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-m);
    }
    figure {
      margin: 0 0 40px;
    }
    .chapter {
      display: grid;
      grid-template-columns: 1fr 1.8fr;
      gap: 48px;
    }
    .chapter,
    .demo-section {
      border-top: 1px solid var(--border);
      padding: clamp(28px, 5vw, 52px) 0;
    }
    .chapter p,
    .demo-section > p {
      max-width: 65ch;
    }
    .chapter p + p,
    .demo-section > p,
    .demo-mount {
      margin-top: 16px;
    }
    footer {
      border-bottom: 0;
      border-top: 1px solid var(--border);
    }
    @media (max-width: 700px) {
      .chapter {
        grid-template-columns: 1fr;
        gap: 16px;
      }
    }
  }
</style>
