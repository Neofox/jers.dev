---
import { EXPRESSIONS } from "../../lib/portrait-catalog.mjs"
import { localeFromPath } from "../i18n/locale.js"
import { faces } from "../i18n/portrait-ko.js"
import PortraitImage from "./PortraitImage.astro"
const ko = localeFromPath(Astro.url.pathname) === "ko"
---

<div class="portrait-dock" id="portrait-dock" hidden>
  <span class="flick-stars" aria-hidden="true"><i>✦</i><i>✧</i><i>✦</i></span>
  <p class="portrait-aside" id="portrait-dock-aside" aria-hidden="true"></p><button
    type="button"
    class="dock-face"
    id="portrait-dock-button"
    aria-haspopup="dialog"
    aria-controls="portrait-dialog"
    aria-label={ko ? "Jérôme의 표정 · 평온" : "Jérôme's reaction: neutral"}
  >
    <span class="pf-face" id="portrait-dock-face">
      <PortraitImage surface="dock" />
    </span>
  </button><button
    type="button"
    class="dock-mute"
    id="portrait-dock-mute"
    aria-pressed="false"
    aria-label={ko ? "반응 끄기" : "Mute me"}
  >
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path
        d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
      >
      </path><path
        class="mute-slash"
        d="M2 14.5 14 1.5"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      >
      </path>
    </svg>
  </button>
</div>
<script define:vars={{ expressions: EXPRESSIONS, names: ko ? faces : {} }}>
  // Restore the same expression before the browser captures the incoming page.
  try {
    const expression = JSON.parse(sessionStorage.getItem("portrait-last-reaction"))?.response?.expression
    if (localStorage.getItem("portrait-muted") !== "1" && expressions.includes(expression)) {
      for (const img of document.querySelectorAll("#portrait-home-face img, #portrait-dock-face img")) {
        img.srcset = img.srcset.replaceAll("neutral", expression)
        img.src = img.src.replace("neutral.webp", expression + ".webp")
      }
      const tag = document.getElementById("portrait-home-tag")
      if (tag) tag.textContent = names[expression] ?? expression
    }
  } catch {}
  // Give incoming page transitions a visible face before the interactive module starts.
  if (["work", "study", "career"].includes(document.body.dataset.stage)) {
    document.getElementById("portrait-dock").hidden = false
  }
</script>
<dialog id="portrait-dialog" class="portrait-drawer" aria-labelledby="pd-title">
  <div class="dialog-top">
    <span class="eyebrow">{ko ? "반응하는 초상화" : "Living portrait"}<span id="pd-model"></span></span><button
      type="button"
      class="icon-button"
      id="pd-close"
      aria-label={ko ? "닫기" : "Close"}
    >
      ×
    </button>
  </div>
  <div class="pd-body">
    <header class="pd-head">
      <span class="pd-thumb">
        <PortraitImage id="pd-face" surface="drawer" />
      </span>
      <div>
        <h2 id="pd-title">{ko ? "왜 이런 표정일까요?" : "Why this face?"}</h2>
        <p class="pd-trigger" id="pd-trigger"></p>
        <p class="pd-sent" id="pd-sent"></p>
      </div>
    </header>
    <p class="pd-quote" id="pd-quote" hidden></p>
    <p class="pd-fallback" id="pd-fallback" data-label={ko ? "기본값" : "fallback"} hidden></p>
    <section aria-labelledby="pd-q-title">
      <h3 class="eyebrow" id="pd-q-title">{ko ? "Decisions API에 한 번에 묻는 네 가지 질문" : "Four questions, one Decisions request"}</h3>
      <ol class="pd-questions">
        <li>
          <p class="pd-qhead"><code>should_react</code><span class="pd-type" id="pd-t-should_react"></span></p>
          <p class="pd-ask" id="pd-q-should_react"></p>
          <div class="pd-answer" id="pd-a-should_react"></div>
        </li>
        <li>
          <p class="pd-qhead"><code>expression</code><span class="pd-type" id="pd-t-expression"></span></p>
          <p class="pd-ask" id="pd-q-expression"></p>
          <div class="pd-answer" id="pd-a-expression"></div>
        </li>
        <li>
          <p class="pd-qhead"><code>aside</code><span class="pd-type" id="pd-t-aside"></span></p>
          <p class="pd-ask" id="pd-q-aside"></p>
          <div class="pd-answer" id="pd-a-aside"></div>
        </li>
        <li>
          <p class="pd-qhead"><code>intensity</code><span class="pd-type" id="pd-t-intensity"></span></p>
          <p class="pd-ask" id="pd-q-intensity"></p>
          <div class="pd-answer" id="pd-a-intensity"></div>
        </li>
      </ol>
    </section>
    <section aria-labelledby="pd-r-title">
      <h3 class="eyebrow" id="pd-r-title">{ko ? "실행 정보" : "Readout"}</h3><dl class="pd-stats">
        <div><dt>{ko ? "응답 시간" : "Latency"}</dt><dd id="pd-latency">—</dd></div>
        <div>
          <dt>{ko ? "예상 비용" : "Est. cost"}</dt><dd id="pd-cost">—</dd>
        </div>
        <div><dt>{ko ? "서버 캐시" : "Server cache"}</dt><dd id="pd-cache">—</dd></div>
        <div>
          <dt>{ko ? "프롬프트 캐시" : "Prompt cache"}</dt><dd id="pd-tokens">—</dd>
        </div>
      </dl>
    </section>
    <div class="pd-mute-row">
      <button type="button" class="pd-mute" id="pd-mute" aria-pressed="false" aria-describedby="pd-mute-note">
        <span>{ko ? "반응 끄기" : "Mute me"}</span><span class="pd-switch" aria-hidden="true"></span>
      </button>
      <p id="pd-mute-note">{ko ? "반응을 끄면 표정이 고정되고 한마디도 표시되지 않아요. 이 설정은 이 기기에 저장돼요." : "Neutral face, no asides, and no reactions are requested. Remembered on this device."}</p>
    </div>
    <footer class="pd-notes">
      <p>{ko ? "OpenAI에는 항목 ID와 동작 유형만 전송해요. 입력한 내용, 방문한 URL, 개인 정보는 보내지 않아요." : "Only item IDs and action types are sent to OpenAI. Nothing you type, no URLs, nothing about you."}</p>
      <p>{ko ? "여덟 가지 표정은 제 사진을 바탕으로 AI로 만들었어요." : "The eight faces are AI-generated variants of my photo."}</p><a
        class="text-link"
        href="/portrait-eval.json"
        target="_blank"
        rel="noopener noreferrer"
      >
        {ko ? "평가 결과" : "Evaluation results"} <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </div>
</dialog>

<script src="../scripts/portrait.js"></script>
