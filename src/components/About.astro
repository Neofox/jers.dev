---
import { chapters } from "../data/career.js"
---
<section class="stage" id="stage-about" aria-labelledby="about-title" data-focus-id="career-about" hidden>
  <header class="page-head" data-reveal>
    <div>
      <p class="eyebrow">About</p>
      <h2 id="about-title" data-focus-id="career-heading">A little more about me.</h2>
    </div>
    <p class="page-note">A career across products, systems and people.</p>
  </header>
  <div class="about-layout">
    <div class="about-person" data-reveal data-focus-id="about-introduction">
      <img
        class="person-portrait"
        src="/assets/jerome-portrait.jpeg"
        width="960"
        height="960"
        alt="Black-and-white portrait of Jérôme Schaeffer"
      />
      <p>I’m based in Seoul, with experience in France, Luxembourg and Korea.</p>
      <p>
        I’ve built across frontend, backend and AI, led teams, and taught web development. Each part gives me a wider
        view of what it takes to deliver a product.
      </p>
    </div>
    <div id="about/career" class="career-history" tabindex="-1">
      <h3 id="career-title">Career history</h3>
      <ol class="career-list" id="chapter-list" aria-labelledby="career-title">
        {chapters.map(c => (
          <li class="career-item" id={`career-${c.id}`} tabindex="-1" data-chapter-item={c.id} data-focus-id={`career-${c.id}`}>
            <p class="career-date">{c.date}</p>
            <div class="career-main">
              <h4>{c.company}</h4>
              <p class="career-role">{c.role}</p>
              <p class="career-description">{c.description}</p>
              {c.project && <a href={`/work/#${c.project === "rubiwin" ? "redspher" : c.project}`} class="text-link" data-focus-id={`career-related-${c.id}`}>Explore related work <span aria-hidden="true">→</span></a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="career-footer">
    <p>Based in Seoul. Connecting the product interface to the systems and people behind it.</p><button
      type="button"
      class="button button-outline"
      data-dialog="resume"
      data-focus-id="resume-information"
      aria-haspopup="dialog"
      aria-controls="detail-dialog"
    >
      Read my résumé <span aria-hidden="true">↗</span>
    </button>
  </div>
</section>
