---
import ThreeIStudy from "../../components/ThreeIStudy.astro"
import { getImage } from "astro:assets"
import lesson from "../../assets/pivo-meet-lesson.webp"

const [small, medium] = await Promise.all([480, 800].map(width => getImage({ src: lesson, width, format: "webp" })))
---

<ThreeIStudy
  slug="pivo-meet"
  image={lesson.src}
  imageWidth={lesson.width}
  imageHeight={lesson.height}
  srcset={`${small.src} 480w, ${medium.src} 800w, ${lesson.src} ${lesson.width}w`}
  sizes="(min-width: 1174px) 1080px, (max-width: 500px) calc(100vw - 40px), 92vw"
/>
