---
interface Props { home?: boolean }
const { home = false } = Astro.props
---
<a class="brand" href={home ? "#home" : "/"} aria-label="Jérôme Schaeffer, portfolio home" data-focus-id="home-brand">
  <span class="brand-mark" aria-hidden="true">js.</span>
  <span class="brand-label" aria-hidden="true">
    <span class="brand-name">Jérôme Schaeffer</span><span class="brand-role">Senior product engineer</span>
  </span>
</a>
