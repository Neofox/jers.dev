---
import PortraitImage from "./PortraitImage.astro"
---
<section class="stage" id="stage-home" aria-labelledby="home-title" data-focus-id="home">
  <div class="home-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">Senior product engineer · Seoul</p>
      <h1 class="hello" id="home-title" data-focus-id="personal-heading">
        <span class="hello-intro">Hi, I’m</span>
        <span class="hero-name">Jérôme</span>
        <span class="surname">Schaeffer.</span>
      </h1>
      <p class="intro">I build the experience.<br />And what makes it work.</p>
      <p class="intro-detail">
        11+ years across frontend, full-stack and AI/AX work: product interfaces, backend systems, 3D viewers and the AI
        tools teams use. I connect the work people see with the systems and collaboration behind it.
      </p>
      <div class="home-actions">
        <a class="button button-primary" href="/work/" data-focus-id="home-selected-work">
          View work <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <figure class="home-person" data-reveal data-focus-id="home-portrait">
      <div class="portrait-composition" id="portrait-composition">
        <button
          type="button"
          class="portrait-home"
          id="portrait-home"
          aria-haspopup="dialog"
          aria-controls="portrait-dialog"
          aria-label="Jérôme's reaction: neutral"
        >
          <span class="pf-face" id="portrait-home-face">
            <PortraitImage surface="home" />
          </span><span class="pf-tag" aria-hidden="true">
            <i></i><span id="portrait-home-tag">neutral</span><span class="pf-why">· why this face?</span>
          </span>
        </button>
        <p class="portrait-aside is-home" id="portrait-home-aside" aria-hidden="true"></p>
      </div>
      <figcaption>
        <span class="person-note">Based in Seoul.<br />Experience across France, Luxembourg &amp; Korea.</span><a
          class="text-link"
          href="#about"
          data-focus-id="home-about"
        >
          A little more about me <span aria-hidden="true">→</span>
        </a>
        <p class="portrait-hint">
          Psst, my face reacts to what you look at. The faces are AI-generated variants of this photo. <button
            type="button"
            class="portrait-hint-button"
            id="portrait-hint"
            aria-haspopup="dialog"
            aria-controls="portrait-dialog"
          >
            Why this face?
          </button>
        </p>
      </figcaption>
    </figure>
    <nav class="home-selection" data-reveal aria-labelledby="home-selection-label">
      <p class="eyebrow" id="home-selection-label">Selected professional experience</p>
      <ul>
        <li>
          <a href="/work/#3i" data-project="3i" data-focus-id="home-3i">
            <span class="selection-company">3i</span><span class="selection-role">
              Frontend Developer &amp; AX Engineer
            </span><span class="selection-scope">Beamo · Pivo · AI/AX</span><span
              class="selection-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
        <li>
          <a href="/work/#enhans" data-project="enhans" data-focus-id="home-enhans">
            <span class="selection-company">Enhans</span><span class="selection-role">Frontend Developer</span><span
              class="selection-scope"
            >
              AI products · LLM agents · ACT-1
            </span><span class="selection-arrow" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href="/work/#redspher" data-project="rubiwin" data-focus-id="home-rubiwin">
            <span class="selection-company">Redspher</span><span class="selection-role">
              Full-stack Developer &amp; Team Lead
            </span><span class="selection-scope">Rubiwin &amp; Supplier Portal</span><span
              class="selection-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</section>
