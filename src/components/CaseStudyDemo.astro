---
interface Props {
  demo: "beamo" | "meet" | "cloud" | "coaches" | "cs"
  label: string
  fallback: string
}
const { demo, label, fallback } = Astro.props
---

<div class="demo-mount" data-study-demo={demo}>
  <button class="button button-primary" type="button" hidden>{label}</button>
  <noscript><p>{fallback}</p></noscript>
</div>

<script>
  import { demoLoaders } from "../scripts/demo-loaders.js"

  for (const stage of document.querySelectorAll<HTMLElement>("[data-study-demo]")) {
    const demo = stage.dataset.studyDemo as "beamo" | "meet" | "cloud" | "coaches" | "cs"
    const open = stage.querySelector<HTMLButtonElement>("button")!
    open.hidden = false
    open.addEventListener("click", async () => {
      open.disabled = true
      open.textContent = "Loading demo…"
      try {
        const { mount } = await demoLoaders[demo]()
        let dispose: (() => void) | void
        function start() {
          dispose?.()
          dispose = mount(stage)
          stage.querySelector("[data-demo-reset]")?.addEventListener("click", start)
          const firstControl = stage.querySelector<HTMLElement | SVGElement>(
            "[data-bm=svg], [data-pm-layout][aria-pressed=true], [data-pc-tab][aria-selected=true], [data-cf=search], [data-cs-filter][aria-pressed=true]",
          )
          firstControl?.focus({ preventScroll: true })
        }
        start()
      } catch {
        open.disabled = false
        open.textContent = "Try opening the demo again"
        stage.replaceChildren(open)
        open.focus()
      }
    })
  }
</script>
