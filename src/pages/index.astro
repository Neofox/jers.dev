---
import PortfolioLayout from "../layouts/PortfolioLayout.astro"
import PortraitImage from "../components/PortraitImage.astro"
import Home from "../components/Home.astro"
import Work from "../components/Work.astro"
import About from "../components/About.astro"
const title = "Jérôme Schaeffer — Senior Product Engineer"
const description =
  "Senior product engineer in Seoul with 11+ years across frontend, full-stack, digital twins and AI/AX. Explore Beamo, Pivo, AI products and selected work."
const socialDescription = "I build the experience. And what makes it work."
---

<PortfolioLayout path="/" {title} {description} {socialDescription}>
    <div id="portfolio">
      <a class="skip" href="#main" data-focus-id="skip-navigation">Skip to content</a>
      <div class="shell">
        <header class="site-header" data-focus-id="portfolio-header">
          <div class="header-inner">
            <a class="brand" href="#home" aria-label="Jérôme Schaeffer — Home" data-focus-id="home-brand">
              <span class="brand-mark" aria-hidden="true">js.</span><span class="brand-label" aria-hidden="true">
                <span class="brand-name">Jérôme Schaeffer</span><span class="brand-role">Senior product engineer</span>
              </span>
            </a>
            <nav class="site-nav" aria-label="Portfolio sections">
              <a href="#work/3i" data-nav="work" data-focus-id="nav-work">Work</a><a
                href="#about"
                data-nav="about"
                data-focus-id="nav-about"
              >
                About
              </a>
            </nav>
            <div class="header-actions">
              <span class="location">Seoul <time id="seoul-time"></time></span><button
                type="button"
                class="text-button header-resume"
                data-dialog="resume"
                data-focus-id="header-resume"
                aria-haspopup="dialog"
                aria-controls="detail-dialog"
              >
                Résumé
              </button><button
                type="button"
                class="button button-outline contact-link"
                data-dialog="contact"
                data-focus-id="persistent-contact"
                aria-haspopup="dialog"
                aria-controls="detail-dialog"
              >
                Let’s talk
              </button>
            </div>
          </div>
        </header>
        <main id="main" tabindex="-1" data-focus-id="portfolio-main">
          <Home />
          <Work />
          <About />
        </main>
        <footer class="site-footer" data-focus-id="persistent-navigation">
          <div class="footer-inner">
            <p class="footer-note">Frontend, backend, AI. Made with curiosity.</p><button
              type="button"
              class="motion-toggle"
              id="motion-toggle"
              aria-pressed="true"
              data-focus-id="motion-toggle"
            >
              <span class="motion-icon" aria-hidden="true"></span><span id="motion-label">Motion on</span>
            </button>
          </div>
        </footer>
      </div>
      <div class="portrait-dock" id="portrait-dock" hidden>
        <p class="portrait-aside" id="portrait-dock-aside" aria-hidden="true"></p><button
          type="button"
          class="dock-face"
          id="portrait-dock-button"
          aria-haspopup="dialog"
          aria-controls="portrait-dialog"
          aria-label="Jérôme's reaction: neutral"
        >
          <span class="pf-face" id="portrait-dock-face">
            <PortraitImage surface="dock" />
          </span>
        </button><button
          type="button"
          class="dock-mute"
          id="portrait-dock-mute"
          aria-pressed="false"
          aria-label="Mute me"
        >
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path
              d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"
            >
            </path><path
              class="mute-slash"
              d="M2 14.5 14 1.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            >
            </path>
          </svg>
        </button>
      </div>
      <dialog id="portrait-dialog" class="portrait-drawer" aria-labelledby="pd-title">
        <div class="dialog-top">
          <span class="eyebrow">Living portrait<span id="pd-model"></span></span><button
            type="button"
            class="icon-button"
            id="pd-close"
            aria-label="Close"
          >
            ×
          </button>
        </div>
        <div class="pd-body">
          <header class="pd-head">
            <span class="pd-thumb">
              <PortraitImage id="pd-face" surface="drawer" />
            </span>
            <div>
              <h2 id="pd-title">Why this face?</h2>
              <p class="pd-trigger" id="pd-trigger"></p>
              <p class="pd-sent" id="pd-sent"></p>
            </div>
          </header>
          <p class="pd-quote" id="pd-quote" hidden></p>
          <p class="pd-fallback" id="pd-fallback" hidden></p>
          <section aria-labelledby="pd-q-title">
            <h3 class="eyebrow" id="pd-q-title">Four questions, one Decisions request</h3>
            <ol class="pd-questions">
              <li>
                <p class="pd-qhead"><code>should_react</code><span class="pd-type" id="pd-t-should_react"></span></p>
                <p class="pd-ask" id="pd-q-should_react"></p>
                <div class="pd-answer" id="pd-a-should_react"></div>
              </li>
              <li>
                <p class="pd-qhead"><code>expression</code><span class="pd-type" id="pd-t-expression"></span></p>
                <p class="pd-ask" id="pd-q-expression"></p>
                <div class="pd-answer" id="pd-a-expression"></div>
              </li>
              <li>
                <p class="pd-qhead"><code>aside</code><span class="pd-type" id="pd-t-aside"></span></p>
                <p class="pd-ask" id="pd-q-aside"></p>
                <div class="pd-answer" id="pd-a-aside"></div>
              </li>
              <li>
                <p class="pd-qhead"><code>intensity</code><span class="pd-type" id="pd-t-intensity"></span></p>
                <p class="pd-ask" id="pd-q-intensity"></p>
                <div class="pd-answer" id="pd-a-intensity"></div>
              </li>
            </ol>
          </section>
          <section aria-labelledby="pd-r-title">
            <h3 class="eyebrow" id="pd-r-title">Readout</h3><dl class="pd-stats">
              <div><dt>Latency</dt><dd id="pd-latency">—</dd></div>
              <div>
                <dt>Est. cost</dt><dd id="pd-cost">—</dd>
              </div>
              <div><dt>Server cache</dt><dd id="pd-cache">—</dd></div>
              <div>
                <dt>Prompt cache</dt><dd id="pd-tokens">—</dd>
              </div>
            </dl>
          </section>
          <div class="pd-mute-row">
            <button type="button" class="pd-mute" id="pd-mute" aria-pressed="false" aria-describedby="pd-mute-note">
              <span>Mute me</span><span class="pd-switch" aria-hidden="true"></span>
            </button>
            <p id="pd-mute-note">Neutral face, no asides, and no reactions are requested. Remembered on this device.</p>
          </div>
          <footer class="pd-notes">
            <p>Only item IDs and action types are sent to OpenAI. Nothing you type, no URLs, nothing about you.</p>
            <p>The eight faces are AI-generated variants of my photo.</p><a
              class="text-link"
              href="/portrait-eval.json"
              target="_blank"
              rel="noopener noreferrer"
            >
              Evaluation results <span aria-hidden="true">↗</span>
            </a>
          </footer>
        </div>
      </dialog>
      <dialog id="detail-dialog" aria-labelledby="dialog-title" data-focus-id="context-dialog">
        <div class="dialog-top">
          <span class="eyebrow" id="dialog-label">Let’s connect</span><button
            type="button"
            class="icon-button"
            id="dialog-close"
            aria-label="Close dialog"
            data-focus-id="close-dialog"
          >
            ×
          </button>
        </div>
        <div class="dialog-body" id="dialog-body"></div>
      </dialog>
      <dialog
        id="image-dialog"
        aria-labelledby="lightbox-title"
        aria-describedby="lightbox-caption"
        data-focus-id="image-lightbox"
      >
        <div class="lightbox-toolbar">
          <h2 id="lightbox-title" data-focus-id="image-title">Product image</h2>
          <div class="lightbox-actions">
            <button
              type="button"
              class="button button-outline"
              id="image-size"
              aria-pressed="false"
              data-focus-id="image-size"
            >
              Actual size
            </button><button
              type="button"
              class="icon-button"
              id="image-close"
              aria-label="Close image"
              data-focus-id="close-image"
            >
              ×
            </button>
          </div>
        </div>
        <div
          class="lightbox-viewport"
          id="lightbox-viewport"
          tabindex="0"
          aria-label="Product image; scroll when viewing actual size"
        >
          <img
            id="lightbox-image"
            src="/assets/translater-product.jpg"
            width="1280"
            height="720"
            alt="Translater entry screen"
          />
        </div>
        <p class="lightbox-caption" id="lightbox-caption">Actual product image.</p>
      </dialog>
      <div class="sr-only" role="status" aria-live="polite" id="stage-announcement"></div>
      <noscript>
        <p class="no-js">
          This interactive portfolio needs JavaScript. Read my <a href="/assets/resume-en.pdf">English résumé</a> or <a
            href="/assets/resume-ko.pdf"
          >
            한국어 이력서
          </a>, or <a href="mailto:jer.schaeffer@gmail.com">email me</a>.
        </p>
      </noscript>
    </div>
    <script is:inline type="module" src="/portrait.mjs"></script>
    <script>
      import "../scripts/portfolio.js"
    </script>
</PortfolioLayout>
