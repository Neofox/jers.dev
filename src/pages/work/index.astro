---
import InteriorHeader from "../../components/InteriorHeader.astro"
import { getImage } from "astro:assets"
import PortraitDock from "../../components/PortraitDock.astro"
import PortfolioLayout from "../../layouts/PortfolioLayout.astro"
import { enhansStudies } from "../../data/enhans-studies"
import { sideStudies } from "../../data/side-studies"
import { studiesKo } from "../../data/studies.ko"
import { localPath, localeFromPath } from "../../i18n/locale.js"

const locale = localeFromPath(Astro.url.pathname)
const translate = (en: string, ko: string) => (locale === "ko" ? ko : en)

async function studyLinks(studies: typeof enhansStudies | typeof sideStudies, collection: string) {
  return Promise.all(
    studies.map(async (study) => ({
      project: collection === "enhans" ? "enhans" : study.slug,
      name: study.name,
      topic: translate(study.topic, studiesKo[study.slug].topic),
      href: `/work/${collection}/${study.slug}/`,
      image: (await getImage({ src: study.image, width: 192, format: "webp" })).src,
    })),
  )
}

const groups = [
  {
    id: "3i",
    title: "3i",
    role: translate(
      "I develop the Beamo digital-twin viewer and Pivo web apps, and lead Claude adoption across engineering and HR.",
      "Beamo 디지털 트윈 뷰어와 Pivo 웹 앱을 개발합니다. 개발팀과 인사팀의 Claude 도입도 이끌고 있습니다.",
    ),
    notes: [
      {
        name: translate("AI adoption at 3i", "3i의 AI 도입"),
        text: translate(
          "I built MCP integrations with role-based access for Google Workspace and internal systems, and developed Claude skills and plugins for the team.",
          "역할별 접근 권한을 적용해 Google Workspace와 사내 시스템을 MCP로 연결했습니다. 팀 업무에 맞는 Claude 스킬과 플러그인도 개발했습니다.",
        ),
        href: "/#work/3i/ax",
        link: translate("View the integration overview", "사내 시스템 연동 사례 보기"),
      },
    ],
    studies: [
      {
        project: "3i",
        name: "Beamo",
        topic: translate("Measuring captured spaces in a 3D viewer", "3D 뷰어에서 촬영한 공간의 치수 재기"),
        href: "/work/beamo/",
        image: "/assets/work-previews/beamo.webp",
      },
      {
        project: "3i",
        name: "Pivo Meet",
        topic: translate("Remote coaching and camera control", "원격 승마 레슨과 카메라 제어"),
        href: "/work/pivo-meet/",
        image: "/assets/work-previews/meet.webp",
      },
      {
        project: "3i",
        name: "Pivo Cloud",
        topic: translate("A video library for practice and lessons", "연습 영상과 레슨 녹화 관리"),
        href: "/work/pivo-cloud/",
        image: "/assets/work-previews/cloud.webp",
      },
      {
        project: "3i",
        name: "Pivo Coaches",
        topic: translate("Finding an equestrian coach", "조건에 맞는 승마 코치 찾기"),
        href: "/work/pivo-coaches/",
        image: "/assets/work-previews/coaches.webp",
      },
      {
        project: "3i",
        name: "Pivo CS / QA",
        topic: translate("Support report triage", "고객 문의 접수와 조사"),
        href: "/work/pivo-cs-qa/",
        image: "/assets/work-previews/cs.webp",
      },
    ],
  },
  {
    id: "enhans",
    title: "Enhans",
    role: translate(
      "I built AI products in React and Next.js, from visual model workflows to the ACT-1 web agent interface.",
      "React와 Next.js로 AI 제품을 개발했습니다. 시각적 워크플로 편집기와 웹 에이전트 ACT-1의 인터페이스가 대표적입니다.",
    ),
    studies: await studyLinks(enhansStudies, "enhans"),
  },
  {
    id: "redspher",
    title: "Redspher",
    role: translate(
      "I led a development team and built logistics software for carriers, working with product managers and product owners.",
      "개발팀을 이끌며 프로덕트 매니저 및 프로덕트 오너와 함께 운송사를 위한 물류 소프트웨어를 개발했습니다.",
    ),
    studies: [],
    notes: [
      {
        name: "Rubiwin",
        text: translate(
          "Carriers upload pricing rules as a CSV. The offer form uses matching rules to suggest a price.",
          "운송사가 요금 규칙을 CSV로 올리면 견적 양식에서 조건에 맞는 규칙을 찾아 금액을 제안합니다.",
        ),
        href: "/#work/rubiwin/rubiwin",
        link: translate("View the pricing screens", "요금 설정 화면 보기"),
      },
      {
        name: "Supplier Portal",
        text: translate(
          "I worked across React, TypeScript and Node.js on transport orders, supplier bidding and real-time chat.",
          "React, TypeScript, Node.js를 사용해 운송 주문, 협력사 입찰, 실시간 채팅 기능을 개발했습니다.",
        ),
        href: "/#work/rubiwin/supplier",
        link: translate("View the portal overview", "협력사 포털 살펴보기"),
      },
    ],
  },
  {
    id: "side-projects",
    title: translate("Side projects", "개인 프로젝트"),
    role: translate(
      "I build and maintain these independent projects, from daily-use apps to libraries and developer tools.",
      "일상에서 쓰는 앱부터 라이브러리와 개발 도구까지, 직접 만들고 유지보수하는 프로젝트입니다.",
    ),
    studies: await studyLinks(sideStudies, "side-projects"),
  },
]
---

<PortfolioLayout
  stage="work"
  path="/work/"
  title={translate("Work — Jérôme Schaeffer", "프로젝트 — Jérôme Schaeffer")}
  description={translate(
    "Explore Jérôme Schaeffer’s engineering case studies and interactive demos from 3i, Enhans, Redspher, and independent projects.",
    "Jérôme Schaeffer가 3i, 인핸스, Redspher에서 개발한 제품과 개인 프로젝트를 소개합니다. 개발 과정과 설계 결정을 읽고 화면에서 직접 체험해 보세요.",
  )}
>
  <a class="skip" href="#work">{translate("Skip to work", "프로젝트 목록으로 건너뛰기")}</a>
  <div class="index">
    <InteriorHeader current="work" />
    <main>
      <div class="work-intro" id="page-intro">
        <h1 id="work" tabindex="-1">{translate("Work", "프로젝트")}</h1>
        <a class="button button-outline career-link" href={localPath("/career/", locale)}><span>{translate("View full ", "전체 ")}<span data-career-title>{translate("career history", "경력 보기")}</span></span> <span aria-hidden="true">→</span></a>
      </div>
      {groups.map(group => (
        <section aria-labelledby={group.id}>
          <div><h2 id={group.id} tabindex="-1">{group.title}</h2><p class="role">{group.role}</p></div>
          <ul>
            {group.studies.map(study => (
              <li>
                <a class="entry" id={study.href.split("/").filter(Boolean).pop()} href={localPath(study.href, locale)} data-project={study.project}>
                  <img src={study.image} alt="" width="96" height="60" loading="lazy" />
                  <span class="entry-text"><strong>{study.name}</strong><span>{study.topic}</span></span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
            {group.notes?.map(note => (
              <li><details data-portrait-project={group.id === "redspher" ? "rubiwin" : group.id}>
                <summary>{note.name}</summary>
                <p>{note.text}</p>
                <a class="text-link" href={localPath(note.href, locale)}>{note.link} →</a>
              </details></li>
            ))}
          </ul>
        </section>
      ))}
    </main>
  </div>
  <PortraitDock />
</PortfolioLayout>

<style>
  .index { width: min(calc(100% - 2 * var(--gutter)), 1080px); margin: 0 auto var(--space-8); }
  .work-intro { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4); margin: clamp(40px, 7vw, 80px) 0; }
  [data-career-title] { display: inline-block; }
  .career-link { color: var(--accent); }
  h1 { margin: 0; font-size: clamp(46px, 8vw, 96px); line-height: 1; letter-spacing: -0.05em; }
  section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.3fr); gap: var(--space-6); padding: var(--space-5) 0 var(--space-7); border-top: 1px solid var(--border-strong); }
  h2 { width: fit-content; padding-top: var(--space-2); font-size: clamp(24px, 3vw, 36px); }
  .role, details p { color: var(--muted); font-size: var(--text-sm); max-width: 42ch; margin: var(--space-2) 0; }
  details[open] { padding-bottom: var(--space-3); }
  summary { padding: var(--space-3) 0; cursor: pointer; font: 600 var(--text-lg) var(--font-display); }
  li + li { border-top: 1px solid var(--border); }
  .entry { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-4); padding: var(--space-3) 0; }
  .entry img { width: clamp(64px, 9vw, 96px); height: auto; aspect-ratio: 8 / 5; object-fit: cover; border-radius: 4px; }
  .entry { scroll-margin-block: min(24vh, 160px); }
  .entry:target strong { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .24em; }
  .entry-text { display: grid; gap: var(--space-1); }
  .entry-text strong { width: fit-content; font: 600 var(--text-lg) var(--font-display); }
  .entry-text > span { color: var(--muted); font-size: var(--text-sm); }
  .arrow { color: var(--accent); }
  .entry:hover strong, .entry:focus-visible strong { text-decoration: underline; text-underline-offset: 0.2em; }
  @media (scripting: none) { details a[href*="/#work/"] { display: none; } }
  @media (max-width: 680px) {
    :global(.portrait-dock) { bottom: calc(12px + env(safe-area-inset-bottom, 0px)); }
    .work-intro { flex-direction: column; align-items: flex-start; }
    section { grid-template-columns: 1fr; gap: var(--space-2); padding: var(--space-4) 0 var(--space-6); }
    .entry { gap: var(--space-3); }
  }
</style>
