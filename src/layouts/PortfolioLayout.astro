---
import { localeFromPath, localPath } from "../i18n/locale.js"
import Terrain from "../components/Terrain.astro"
import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import "../styles/globals.css"

interface Props {
  stage?: "work" | "study" | "career"
  title: string
  description: string
  socialDescription?: string
  path: string
  image?: string
  imageAlt?: string
  imageWidth?: number
  imageHeight?: number
  type?: "article" | "website"
}
const {
  stage,
  title,
  description,
  socialDescription = description,
  path,
  image = "/assets/jerome-portrait.jpeg",
  imageAlt = "Jérôme Schaeffer",
  imageWidth = 960,
  imageHeight = 960,
  type = "website",
} = Astro.props
const locale = localeFromPath(Astro.url.pathname)
const pagePath = path.replace(/\/?$/, "/")
const english = new URL(localPath(pagePath, "en"), Astro.site)
const korean = new URL(localPath(pagePath, "ko"), Astro.site)
const canonical = locale === "ko" ? korean : english
const socialImage = new URL(image, Astro.site)
---

<!doctype html>
<html lang={locale} data-motion="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
    </style>
    <slot name="head" />
    <link rel="expect" href={stage === "study" ? "#study-preview" : "#page-intro"} blocking="render" media="(prefers-reduced-motion: no-preference)" />
    <link rel="expect" href={stage ? "#portrait-dialog" : "#portrait-home-face"} blocking="render" media="(prefers-reduced-motion: no-preference)" />
    <script is:inline>
      (() => {
        const root = document.documentElement
        const reduced = matchMedia("(prefers-reduced-motion: reduce)")
        function sync() {
          let enabled = !reduced.matches
          try { enabled &&= localStorage.getItem("jerome-studio-motion") !== "off" } catch {}
          root.dataset.motion = enabled ? "on" : "off"
        }
        sync()
        reduced.addEventListener("change", sync)
        window.addEventListener("pageshow", sync)
        function pagePath(url) { return url.pathname.replace(/^\/ko(?=\/|$)/, "") || "/" }
        function depth(url) {
          if (pagePath(url) === "/") return url.hash.startsWith("#work") ? 2 : 0
          return pagePath(url) === "/work/" ? 1 : 2
        }

        function share(transition, element, name) {
          if (!element) return
          const bounds = element.getBoundingClientRect()
          if (!bounds.width || bounds.bottom <= 0 || bounds.top >= innerHeight) return
          element.style.viewTransitionName = name
          transition.finished.finally(() => element.style.removeProperty("view-transition-name"))
        }

        function connect(transition, other) {
          const here = pagePath(location)
          const there = pagePath(other)
          const onIndex = here === "/work/"
          const detail = onIndex ? there : here
          if (!onIndex && there !== "/work/") return
          if (detail.startsWith("/work/") && detail !== "/work/") {
            const row = onIndex ? [...document.querySelectorAll("a.entry")].find(link => pagePath(link) === detail) : null
            share(transition, onIndex ? row?.querySelector("img") : document.querySelector("#study-preview"), "project-preview")
            share(transition, onIndex ? row?.querySelector("strong") : document.querySelector("[data-project-name]"), "project-name")
          } else if (detail === "/career/") {
            const group = (onIndex ? location.hash : other.hash).slice(1)
            if (["3i", "enhans", "redspher"].includes(group)) {
              const company = onIndex ? document.getElementById(group) : document.querySelector(`#career-${group} h2`)
              share(transition, company, "company-name")
            } else {
              share(transition, document.querySelector("[data-career-title]"), "career-label")
            }
          } else if (detail === "/" && ["#3i", "#enhans", "#redspher"].includes(onIndex ? location.hash : other.hash)) {
            const hash = onIndex ? location.hash : other.hash
            const company = onIndex ? document.getElementById(hash.slice(1)) : document.querySelector(`.home-selection a[href$="/work/${hash}"] .selection-company`)
            share(transition, company, "company-name")
          } else if (detail === "/" && !(onIndex ? other.hash : location.hash)) {
            share(transition, document.querySelector(onIndex ? "h1" : "[data-work-title]"), "work-label")
          }
        }

        window.addEventListener("pagereveal", event => {
          const transition = event.viewTransition
          if (!transition) return
          sync()
          if (root.dataset.motion === "off") return transition.skipTransition()
          const from = window.navigation?.activation?.from
          if (!from?.url) return
          const previous = new URL(from.url)
          const direction = depth(location) - depth(previous)
          if (direction) transition.types?.add(direction > 0 ? "forward" : "backward")
          if (pagePath(location) === "/career/" && pagePath(previous) === "/work/") transition.types?.add("timeline-in")
          if (pagePath(location).startsWith("/work/") && pagePath(location) !== "/work/" && pagePath(previous) === "/work/") {
            transition.types?.add("study-open")
          }
          connect(transition, previous)
        })
        window.addEventListener("pageswap", event => {
          const transition = event.viewTransition
          if (!transition) return
          if (root.dataset.motion === "off") return transition.skipTransition()
          if (event.activation?.entry?.url) connect(transition, new URL(event.activation.entry.url))
        })
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={english} />
    <link rel="alternate" hreflang="ko" href={korean} />
    <link rel="alternate" hreflang="x-default" href={english} />
    <meta property="og:locale" content={locale === "ko" ? "ko_KR" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "ko" ? "en_US" : "ko_KR"} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:width" content={imageWidth} />
    <meta name="twitter:image:height" content={imageHeight} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body data-stage={stage}>
    {stage && <Terrain compact />}
    <slot />
    <script>
      // Keep light dismissal on browsers that predate the closedby attribute.
      if (!("closedBy" in HTMLDialogElement.prototype)) {
        for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[closedby="any"]')) {
          dialog.addEventListener("click", (event) => {
            if (event.target !== dialog) return
            const r = dialog.getBoundingClientRect()
            if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)
              dialog.close()
          })
        }
      }
    </script>
    <script is:inline defer src="https://app.rybbit.io/api/script.js" data-site-id="1712"></script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
