---
import { portraitSources } from "../../public/portrait-core.mjs"
import CareerTimeline from "../components/CareerTimeline.astro"
import PortraitDock from "../components/PortraitDock.astro"
import PortfolioLayout from "../layouts/PortfolioLayout.astro"
---

<PortfolioLayout stage="career" path="/career/" title="Career history — Jérôme Schaeffer"
  description="Jérôme Schaeffer’s engineering and teaching roles since 2015, from banking and logistics in Europe to AI products and digital twins in Seoul.">
  <a class="skip" href="#career-title">Skip to career history</a>
  <div class="career-page">
    <header class="mast">
      <a href="/" aria-label="Jérôme Schaeffer, portfolio home">Jérôme Schaeffer</a>
      <a href="/work/">Work</a>
    </header>
    <main>
      <div id="page-intro">
        <div class="career-bio">
          <h1 id="career-title" tabindex="-1" data-career-title>Career history</h1>
          <p>I’m based in Seoul, with experience in France, Luxembourg and Korea. I’ve built across frontend, backend and AI, led teams, and taught web development.</p>
        </div>
        <div class="career-portrait">
          <img class="career-fallback" {...portraitSources("neutral")} sizes="(max-width: 600px) 64px, 120px" width="120" height="120" alt="Jérôme Schaeffer" />
          <PortraitDock />
        </div>
      </div>
      <CareerTimeline />
    </main>
    <footer><a class="text-link" href="/assets/resume-en.pdf" hreflang="en">English résumé (PDF)</a><a class="text-link" href="/assets/resume-ko.pdf" hreflang="ko" lang="ko">한국어 이력서 (PDF)</a></footer>
  </div>
</PortfolioLayout>

<style>
  .career-page { width: min(calc(100% - 2 * var(--gutter)), 1080px); margin: 0 auto var(--space-8); }
  .mast, footer { display: flex; align-items: baseline; gap: var(--space-4); padding: var(--space-5) 0; }
  .mast { justify-content: space-between; font-size: var(--text-sm); border-bottom: 1px solid var(--border); }
  .mast a:first-child { font: 600 var(--text-lg) var(--font-display); }
  #page-intro { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: var(--space-4); margin: clamp(32px, 6vw, 68px) 0; }
  .career-bio p { margin-top: var(--space-3); max-width: 58ch; color: var(--muted); }
  .career-portrait { position: relative; width: 120px; aspect-ratio: 1; }
  .career-fallback { display: block; width: 100%; height: 100%; border-radius: var(--radius-m); }
  .career-portrait:has(:global(.portrait-dock:not([hidden]))) .career-fallback { visibility: hidden; }
  .career-portrait:not([data-floating]) :global(.portrait-dock) { position: absolute; inset: 0; view-transition-name: none; }
  .career-portrait:not([data-floating]) :global(.dock-face) { width: 100%; height: 100%; border-radius: var(--radius-m); box-shadow: none; }
  .career-portrait:not([data-floating]) :global(.pf-face img) { scale: 1; }
  @media (max-width: 600px) {
    #page-intro { grid-template-columns: 1fr 64px; row-gap: var(--space-3); }
    .career-bio { display: contents; }
    .career-bio p { grid-column: 1 / -1; grid-row: 2; margin: 0; }
    .career-portrait { grid-column: 2; grid-row: 1; width: 64px; }
  }
  h1 { width: fit-content; margin: 0; font-size: clamp(42px, 7vw, 88px); line-height: 1; letter-spacing: -.05em; }
  footer { flex-wrap: wrap; }
</style>
