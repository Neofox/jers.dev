---
import { getImage } from "astro:assets"
import PortraitDock from "../../components/PortraitDock.astro"
import PortfolioLayout from "../../layouts/PortfolioLayout.astro"
import { enhansStudies } from "../../data/enhans-studies"
import { sideStudies } from "../../data/side-studies"

async function studyLinks(studies: typeof enhansStudies | typeof sideStudies, collection: string) {
  return Promise.all(studies.map(async study => ({
    project: collection === "enhans" ? "enhans" : study.slug,
    name: study.name,
    topic: study.topic,
    href: `/work/${collection}/${study.slug}/`,
    image: (await getImage({ src: study.image, width: 192, format: "webp" })).src,
  })))
}

const groups = [
  {
    id: "3i",
    title: "3i",
    role: "I develop the Beamo digital-twin viewer and Pivo web apps, and lead Claude adoption across engineering and HR.",
    notes: [{ name: "AI adoption at 3i", text: "I built MCP integrations with role-based access for Google Workspace and internal systems, and developed Claude skills and plugins for the team.", href: "/#work/3i/ax", link: "View the integration overview" }],
    studies: [
      { project: "3i", name: "Beamo", topic: "Measuring captured spaces in a 3D viewer", href: "/work/beamo/", image: "/assets/work-previews/beamo.webp" },
      { project: "3i", name: "Pivo Meet", topic: "Remote coaching and camera control", href: "/work/pivo-meet/", image: "/assets/work-previews/meet.webp" },
      { project: "3i", name: "Pivo Cloud", topic: "A video library for practice and lessons", href: "/work/pivo-cloud/", image: "/assets/work-previews/cloud.webp" },
      { project: "3i", name: "Pivo Coaches", topic: "Finding an equestrian coach", href: "/work/pivo-coaches/", image: "/assets/work-previews/coaches.webp" },
      { project: "3i", name: "Pivo CS / QA", topic: "Support report triage", href: "/work/pivo-cs-qa/", image: "/assets/work-previews/cs.webp" },
    ],
  },
  { id: "enhans", title: "Enhans", role: "I built AI products in React and Next.js, from visual model workflows to the ACT-1 web agent interface.", studies: await studyLinks(enhansStudies, "enhans") },
  {
    id: "redspher", title: "Redspher",
    role: "I led a development team and built logistics software for carriers, working with product managers and product owners.",
    studies: [],
    notes: [
      { name: "Rubiwin", text: "Carriers upload pricing rules as a CSV. The offer form uses matching rules to suggest a price.", href: "/#work/rubiwin/rubiwin", link: "View the pricing screens" },
      { name: "Supplier Portal", text: "I worked across React, TypeScript and Node.js on transport orders, supplier bidding and real-time chat.", href: "/#work/rubiwin/supplier", link: "View the portal overview" },
    ],
  },
  { id: "side-projects", title: "Side projects", role: "I build and maintain these independent projects, from daily-use apps to libraries and developer tools.", studies: await studyLinks(sideStudies, "side-projects") },
]
---

<PortfolioLayout stage="work" path="/work/" title="Work — Jérôme Schaeffer" description="Explore Jérôme Schaeffer’s engineering case studies and interactive demos from 3i, Enhans, Redspher, and independent projects.">
  <a class="skip" href="#work">Skip to work</a>
  <div class="index">
    <header><a href="/" aria-label="Jérôme Schaeffer, portfolio home">Jérôme Schaeffer</a><a href="/#about">About</a></header>
    <main>
      <div class="work-intro" id="page-intro">
        <h1 id="work" tabindex="-1">Work</h1>
        <a class="button button-outline career-link" href="/career/"><span>View full <span data-career-title>career history</span></span> <span aria-hidden="true">→</span></a>
      </div>
      {groups.map(group => (
        <section aria-labelledby={group.id}>
          <div><h2 id={group.id} tabindex="-1">{group.title}</h2><p class="role">{group.role}</p></div>
          <ul>
            {group.studies.map(study => (
              <li>
                <a class="entry" href={study.href} data-project={study.project}>
                  <img src={study.image} alt="" width="96" height="60" loading="lazy" />
                  <span class="entry-text"><strong>{study.name}</strong><span>{study.topic}</span></span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
            {group.notes?.map(note => (
              <li><details data-portrait-project={group.id === "redspher" ? "rubiwin" : group.id}>
                <summary>{note.name}</summary>
                <p>{note.text}</p>
                <a class="text-link" href={note.href}>{note.link} →</a>
              </details></li>
            ))}
          </ul>
        </section>
      ))}
    </main>
  </div>
  <PortraitDock />
</PortfolioLayout>

<style>
  .index { width: min(calc(100% - 2 * var(--gutter)), 1080px); margin: 0 auto var(--space-8); }
  header { display: flex; align-items: baseline; justify-content: space-between; padding: var(--space-5) 0; border-bottom: 1px solid var(--border); }
  header a:first-child { font: 600 var(--text-lg) var(--font-display); }
  header a:last-child { font-size: var(--text-sm); }
  .work-intro { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4); margin: clamp(40px, 7vw, 80px) 0; }
  [data-career-title] { display: inline-block; }
  .career-link { color: var(--accent); }
  h1 { margin: 0; font-size: clamp(46px, 8vw, 96px); line-height: 1; letter-spacing: -0.05em; }
  section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.3fr); gap: var(--space-6); padding: var(--space-5) 0 var(--space-7); border-top: 1px solid var(--border-strong); }
  h2 { padding-top: var(--space-2); font-size: clamp(24px, 3vw, 36px); }
  .role, details p { color: var(--muted); font-size: var(--text-sm); max-width: 42ch; margin: var(--space-2) 0; }
  details[open] { padding-bottom: var(--space-3); }
  summary { padding: var(--space-3) 0; cursor: pointer; font: 600 var(--text-lg) var(--font-display); }
  li + li { border-top: 1px solid var(--border); }
  .entry { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-4); padding: var(--space-3) 0; }
  .entry img { width: clamp(64px, 9vw, 96px); height: auto; aspect-ratio: 8 / 5; object-fit: cover; border-radius: 4px; }
  .entry-text { display: grid; gap: var(--space-1); }
  .entry-text strong { font: 600 var(--text-lg) var(--font-display); }
  .entry-text > span { color: var(--muted); font-size: var(--text-sm); }
  .arrow { color: var(--accent); }
  .entry:hover strong, .entry:focus-visible strong { text-decoration: underline; text-underline-offset: 0.2em; }
  @media (scripting: none) { details a[href^="/#work/"] { display: none; } }
  @media (max-width: 680px) {
    :global(.portrait-dock) { bottom: calc(12px + env(safe-area-inset-bottom, 0px)); }
    .work-intro { flex-direction: column; align-items: flex-start; }
    section { grid-template-columns: 1fr; gap: var(--space-2); padding: var(--space-4) 0 var(--space-6); }
    .entry { gap: var(--space-3); }
  }
</style>
